# ==============================================================================
# System Design Agent Pipeline - Environment Configuration
# ==============================================================================

# LLM Provider selection: 'gemini', 'openai', 'ollama', or 'mock'
# If omitted, auto-detects based on which API key is present.
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / OpenAI-compatible (Groq, DeepSeek, LocalAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Local LLM
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Pipeline Defaults
DEFAULT_DAU=50000
SPECS_DB_PATH=specs.db
OUTPUT_DIR=specs
